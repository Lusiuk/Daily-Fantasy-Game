  m_EditorHideFlags: 0
  m_Script: {fileID: 11500000, guid: 95b7243bdfb9b0e4c9be59d12e624b02, type: 3}
  m_Name: 
  m_EditorClassIdentifier: Assembly-CSharp::CodeAssemblyGameManager
  availableBlocksContainer: {fileID: 1066072075}
  buildZoneContainer: {fileID: 1855159432}
  titleText: {fileID: 1891905953}
  resultText: {fileID: 1843620583}
  checkButton: {fileID: 648173175}
  resetButton: {fileID: 753983131}
  availableBlocksScrollRect: {fileID: 0}
  codeBlockPrefab: {fileID: 5766246743845387956, guid: 7139d9a21e1c440f2979c068b4cc81df, type: 3}
  levels:
  - levelName: "1. \u041F\u0440\u0438\u0432\u0435\u0442, \u043C\u0438\u0440!"
    correctCodeLines:
    - using System;
    - class Program
    - '{'
    - '    static void Main()'
    - '    {'
    - '        Console.WriteLine(\"Hello, World!\");'
    - '    }'
    - '}'
    description: "\u0421\u043E\u0431\u0435\u0440\u0438 \u043F\u0440\u043E\u0441\u0442\u0443\u044E
      \u043F\u0440\u043E\u0433\u0440\u0430\u043C\u043C\u0443 \u043D\u0430 C# \u0434\u043B\u044F
      \u0432\u044B\u0432\u043E\u0434\u0430 \u0441\u043E\u043E\u0431\u0449\u0435\u043D\u0438\u044F"
  - levelName: "2. \u041F\u0440\u043E\u0432\u0435\u0440\u043A\u0430 \u0447\u0438\u0441\u043B\u0430"
    correctCodeLines:
    - int number = 5;
    - if (number > 0)
    - '{'
    - "    Console.WriteLine(\\\"\u0427\u0438\u0441\u043B\u043E \u043F\u043E\u043B\u043E\u0436\u0438\u0442\u0435\u043B\u044C\u043D\u043E\u0435\\\");"
    - '}'
    - else
    - '{'
    - "    Console.WriteLine(\\\"\u0427\u0438\u0441\u043B\u043E \u043D\u0435 \u043F\u043E\u043B\u043E\u0436\u0438\u0442\u0435\u043B\u044C\u043D\u043E\u0435\\\");"
    - '}'
    description: "\u041D\u0430\u043F\u0438\u0448\u0438 \u043A\u043E\u0434, \u043A\u043E\u0442\u043E\u0440\u044B\u0439
      \u043F\u0440\u043E\u0432\u0435\u0440\u044F\u0435\u0442, \u043F\u043E\u043B\u043E\u0436\u0438\u0442\u0435\u043B\u044C\u043D\u043E\u0435
      \u043B\u0438 \u0447\u0438\u0441\u043B\u043E"
  - levelName: "3. \u0427\u0451\u0442\u043D\u044B\u0435 \u0447\u0438\u0441\u043B\u0430"
    correctCodeLines:
    - for (int i = 0; i <= 10; i++)
    - '{'
    - '    if (i % 2 == 0)'
    - '    {'
    - "        Console.WriteLine(i + \\\" - \u0447\u0451\u0442\u043D\u043E\u0435\\\");"
    - '    }'
    - '}'
    - "// \u0413\u043E\u0442\u043E\u0432\u043E!"
    description: "\u0412\u044B\u0432\u0435\u0434\u0438 \u0432\u0441\u0435 \u0447\u0451\u0442\u043D\u044B\u0435
      \u0447\u0438\u0441\u043B\u0430 \u043E\u0442 0 \u0434\u043E 10"
