  m_Script: {fileID: 11500000, guid: 63f8110737f5c4023b38ad314583e169, type: 3}
  m_Name: 
  m_EditorClassIdentifier: Assembly-CSharp::IDEMinigameController
  availableBlocksContainer: {fileID: 1220340230}
  BuildZoneContainers:
  - {fileID: 1321111079}
  - {fileID: 55622273}
  - {fileID: 592827162}
  - {fileID: 1720546619}
  titleText: {fileID: 792128014}
  resultText: {fileID: 973638786}
  checkButton: {fileID: 648173175}
  resetButton: {fileID: 753983131}
  Answer: {fileID: 3707985673083407710, guid: 96d7ab14b96264880bd554fac46cc9b5, type: 3}
  AnswerSlot: {fileID: 3617122811698798457, guid: 521d9e796d5e145d7b041a3f631078f3, type: 3}
  levels:
  - levelName: Level0.zs
    correctCodeLines:
    - "\u041D\u0430\u0447\u0430\u043B\u043E"
    - "\u0412\u044B\u0432\u0435\u0441\u0442\u0438"
    - "\u041F\u0440\u043E\u0433\u0440\u0430\u043C\u043C\u044B"
    description: "\u0412\u044B\u0432\u0435\u0441\u0442\u0438 \u0444\u0440\u0430\u0437\u0443
      \u201C\u041F\u0440\u0438\u0432\u0435\u0442, \u041C\u0435\u0445\u043C\u0430\u0442!\u201D."
  - levelName: Level1.zs
    correctCodeLines:
    - "\u041F\u0440\u043E\u0433\u0440\u0430\u043C\u043C\u044B"
    - "\u042F_\u0432\u044B\u0441\u043F\u0430\u043B\u0441\u044F"
    - "\u0412\u0435\u0440\u043D\u0443\u0442\u044C"
    description: "\u0412 \u0437\u0430\u0432\u0438\u0441\u0438\u043C\u043E\u0441\u0442\u0438
      \u043E\u0442 \u0442\u043E\u0433\u043E, \u0432\u044B\u0441\u043F\u0430\u043B\u0441\u044F
      \u043B\u0438 \u0442\u044B, \u0432\u0435\u0440\u043D\u0443\u0442\u044C \u0440\u0430\u0437\u043D\u044B\u0435
      \u043E\u0442\u0432\u0435\u0442\u044B."
  - levelName: Level2.zs
    correctCodeLines:
    - "\u0412\u0432\u0435\u0441\u0442\u0438()"
    - "\u041F\u043E\u043A\u0430"
    - "\u042F"
    - "\u0418\u043D\u0430\u0447\u0435"
    - "\u041F\u0440\u043E\u0433\u0440\u0430\u043C\u043C\u044B"
    description: "\u041D\u0430\u043F\u0438\u0441\u0430\u0442\u044C \u043F\u0440\u043E\u0433\u0440\u0430\u043C\u043C\u0443,
      \u043A\u043E\u0442\u043E\u0440\u0430\u044F \u043F\u0440\u043E\u0432\u0435\u0440\u044F\u0435\u0442,
      \u043C\u043E\u0436\u043D\u043E \u043B\u0438 \u0438\u0433\u0440\u0430\u0442\u044C
      \u0432 DF, \u0435\u0441\u043B\u0438 \u043C\u0430\u043C\u0430 \u0441\u043C\u043E\u0442\u0440\u0438\u0442
      \u0438 \u0414\u0417 \u0441\u0434\u0435\u043B\u0430\u043D\u043E."
  - levelName: Level3.zs
    correctCodeLines:
    - "\u0412\u0432\u0435\u0441\u0442\u0438()"
    - "\u041D\u0435"
    - "\u0415\u0441\u043B\u0438"
    - + 1
    - "\u0414\u0440\u0443\u0437\u0435\u0439"
    description: "\u041F\u043E\u0434\u0441\u0442\u0430\u0432\u0438\u0442\u044C \u043F\u0440\u043E\u043F\u0443\u0449\u0435\u043D\u043D\u044B\u0435
      \u0447\u0430\u0441\u0442\u0438 \u0432 \u043F\u0440\u043E\u0433\u0440\u0430\u043C\u043C\u0443
      \u043F\u043E\u0434\u0441\u0447\u0451\u0442\u0430 \u0434\u0440\u0443\u0437\u0435\u0439."
  completionDialogue: {fileID: 11400000, guid: 54687e9293efafb48960b077328b63db, type: 2}
