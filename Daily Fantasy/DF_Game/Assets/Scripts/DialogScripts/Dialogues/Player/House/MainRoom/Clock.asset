  m_Name: Clock
  m_EditorClassIdentifier: Assembly-CSharp::Dialogue
  text: "\u041D\u0430\u043F\u043E\u043B\u044C\u043D\u044B\u0435 \u0441\u0442\u0430\u0440\u044B\u0435
    \u0447\u0430\u0441\u044B. \u041E\u043D\u0438 \u0441\u0442\u043E\u044F\u0442.
    \u0415\u0441\u043B\u0438 \u0447\u0435\u0441\u0442\u043D\u043E, \u044F \u0432\u043E\u043E\u0431\u0449\u0435
    \u043D\u0435 \u043F\u043E\u043C\u043D\u044E, \u0447\u0442\u043E\u0431\u044B \u043E\u043D\u0438
    \u0448\u043B\u0438. \u041C\u043E\u0436\u0435\u0442 \u0441\u0442\u0440\u0435\u043B\u043A\u0438
    \u0437\u0430\u043C\u0435\u0440\u043B\u0438 \u043D\u0430 \u043D\u0438\u0445 \u0441\u0442\u043E
    \u0441 \u043B\u0438\u0448\u043D\u0438\u043C \u043B\u0435\u0442 \u043D\u0430\u0437\u0430\u0434...
    \u041D\u0430\u0436\u043C\u0438 R, \u0447\u0442\u043E\u0431\u044B \u043D\u0435
    \u043F\u043E\u0434\u0440\u0430\u0436\u0430\u0442\u044C \u0447\u0430\u0441\u0430\u043C."
