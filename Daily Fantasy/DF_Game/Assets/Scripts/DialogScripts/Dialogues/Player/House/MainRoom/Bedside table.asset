  text: "\u0422\u0443\u043C\u0431\u043E\u0447\u043A\u0430 \u0435\u0441\u0442\u044C,
    \u0430 \u0441\u0442\u0443\u043B\u0430 \u043D\u0435\u0442. \u041D\u0430\u0436\u043C\u0438
