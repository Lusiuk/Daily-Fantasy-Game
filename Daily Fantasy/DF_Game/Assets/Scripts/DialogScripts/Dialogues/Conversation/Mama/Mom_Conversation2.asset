  lines:
  - text: "\u041C\u0430\u0430\u0430\u043C, \u044F \u043F\u0440\u0438\u043D\u0451\u0441
      \u044F\u0431\u043B\u043E\u043A\u0438 \u043D\u0430 \u043F\u0438\u0440\u043E\u0433.
      [R]"
    isPlayerSpeaking: 1
    npcName: 
  - text: "\u041A\u0430\u043A\u043E\u0439 \u0442\u044B \u0441\u0435\u0433\u043E\u0434\u043D\u044F
      \u043C\u043E\u043B\u043E\u0434\u0435\u0446, \u0438 \u044F\u0431\u043B\u043E\u043A\u0438
      \u043A\u0443\u043F\u0438\u043B, \u0438 \u0446\u0432\u0435\u0442\u043E\u043A
      \u043F\u043E\u043B\u0438\u043B. [R]"
    isPlayerSpeaking: 0
    npcName: "\u041C\u0430\u043C\u0430"
  - text: "\u0422\u0435\u043F\u0435\u0440\u044C \u043D\u0430 \u043A\u0443\u0445\u043D\u0435
      \u043D\u0430\u0434\u043E \u0435\u0433\u043E \u043F\u0440\u0438\u0433\u043E\u0442\u043E\u0432\u0438\u0442\u044C.
      [R]"
    isPlayerSpeaking: 0
    npcName: "\u041C\u0430\u043C\u0430"
  - text: "\u041F\u043E\u043D\u044F\u043B, \u0441\u0434\u0435\u043B\u0430\u044E.
      [R]"
    isPlayerSpeaking: 1
