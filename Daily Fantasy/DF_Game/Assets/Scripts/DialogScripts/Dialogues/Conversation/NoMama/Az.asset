  typewriterMusic: {fileID: 8300000, guid: dd4068423f967d241aa87d438833ed6c, type: 3}
  loopMusic: 1
  dialogueId: 56en7
  oneTimeUse: 1
  isPlayerSpeaking: 0
  npcName: "\u0410\u0437"
  lines:
  - text: "\u041F\u0440\u0438\u0432\u0435\u0442\u0441\u0442\u0432\u0443\u044E, \u041F\u0443\u0442\u043D\u0438\u043A!
      \u0427\u0442\u043E\u0431\u044B \u0432\u044B\u0431\u0440\u0430\u0442\u044C\u0441\u044F
      \u043E\u0442\u0441\u044E\u0434\u0430 \u0442\u0435\u0431\u0435 \u043F\u0440\u0435\u0434\u0441\u0442\u043E\u0438\u0442
      \u043F\u0440\u043E\u0439\u0442\u0438 \u0432\u0441\u0435 \u0442\u0440\u0438
      \u0438\u0441\u043F\u044B\u0442\u0430\u043D\u0438\u044F. [R]"
    isPlayerSpeaking: 0
    npcName: 
  - text: "\u041A\u043E\u043D\u0435\u0446 \u043A\u0430\u0436\u0434\u043E\u0433\u043E
      \u0431\u0443\u0434\u0435\u0442 \u043E\u0437\u043D\u0430\u043C\u0435\u043D\u043E\u0432\u0430\u043D
      \u0437\u0430\u043E\u0441\u0442\u0440\u0435\u043D\u043D\u044B\u043C \u0444\u043B\u0430\u0436\u043A\u043E\u043C.
      [R]"
    isPlayerSpeaking: 0
    npcName: 
  - text: "\u0427\u0442\u043E\u0431\u044B \u0434\u0432\u0438\u0433\u0430\u0442\u044C\u0441\u044F
      \u0438\u0441\u043F\u043E\u043B\u044C\u0437\u0443\u0439 \u0442\u0435 \u0436\u0435
      \u043A\u043D\u043E\u043F\u043A\u0438! [R]"
    isPlayerSpeaking: 0
    npcName: 
  - text: "\u041A\u0430\u0436\u0434\u044B\u0439 \u044D\u0442\u0430\u043F \u0434\u0430\u0441\u0442
      \u0442\u0435\u0431\u0435 \u043D\u043E\u0432\u0443\u044E \u0432\u043E\u0437\u043C\u043E\u0436\u043D\u043E\u0441\u0442\u044C:\r\n
      \u041F\u0440\u044B\u0436\u043E\u043A (W, \u2191 \u0438\u043B\u0438 Space);
      \u0420\u044B\u0432\u043E\u043A (L.Shift) [R]"
    isPlayerSpeaking: 0
    npcName: 
  - text: "\u041A\u0430\u0436\u0434\u044B\u0439 \u044D\u0442\u0430\u043F \u0434\u0430\u0441\u0442
      \u0442\u0435\u0431\u0435 \u043D\u043E\u0432\u0443\u044E \u0432\u043E\u0437\u043C\u043E\u0436\u043D\u043E\u0441\u0442\u044C:
      \u041F\u0440\u044B\u0436\u043E\u043A \u0438 \u0414\u0432\u043E\u0439\u043D\u043E\u0439
      \u041F\u0440\u044B\u0436\u043E\u043A (W, \u2191 \u0438\u043B\u0438 Space);
      \u0420\u044B\u0432\u043E\u043A (L.Shift) [R]"
    isPlayerSpeaking: 0
    npcName: 
  - text: "\u0410, \u0438 \u0435\u0449\u0451, \u0447\u0442\u043E\u0431\u044B \u0432\u0437\u0430\u0438\u043C\u043E\u0434\u0435\u0439\u0441\u0442\u0432\u043E\u0432\u0430\u0442\u044C
      \u0441 \u043F\u0440\u0435\u0434\u043C\u0435\u0442\u0430\u043C\u0438, \u043D\u0443\u0436\u043D\u043E
      \u0437\u0430\u0436\u0430\u0442\u044C R. [R]"
    isPlayerSpeaking: 0
    npcName: 
