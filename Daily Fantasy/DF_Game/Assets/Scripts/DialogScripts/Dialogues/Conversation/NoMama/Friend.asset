  typewriterMusic: {fileID: 8300000, guid: dd4068423f967d241aa87d438833ed6c, type: 3}
  loopMusic: 1
  dialogueId: 7t986t6
  oneTimeUse: 1
  isPlayerSpeaking: 0
  npcName: "\u041F\u0435\u0442\u044F"
  lines:
  - text: "\u0416\u0435\u043D\u0451\u043A, \u043F\u0440\u0438\u0432\u0435\u0442!
      \u0427\u0435\u0433\u043E \u0442\u0435\u0431\u044F \u0441\u0435\u0433\u043E\u0434\u043D\u044F
      \u0432 \u0448\u043A\u043E\u043B\u0435 \u043D\u0435 \u0431\u044B\u043B\u043E?
      [R]"
    isPlayerSpeaking: 0
    npcName: 
  - text: "\u041F\u0440\u0438\u0432\u0435\u0442! \u041D\u0438\u043A\u0430\u043A \u043D\u0435
      \u043C\u043E\u0433 \u0432\u0441\u0442\u0430\u0442\u044C \u0441 \u043A\u0440\u043E\u0432\u0430\u0442\u0438.
      [R]"
    isPlayerSpeaking: 1
    npcName: 
  - text: "\u0417\u0443\u0431 \u0434\u0430\u044E, \u0447\u0442\u043E \u0442\u044B
      \u043E\u043F\u044F\u0442\u044C \u0432\u0441\u044E \u043D\u043E\u0447\u044C
      \u0444\u0430\u043D\u0442\u0430\u0437\u0438\u0440\u043E\u0432\u0430\u043B, \u043A\u0435\u043C
      \u0431\u044B \u0442\u044B \u043C\u043E\u0433 \u0431\u044B\u0442\u044C.  [R]"
    isPlayerSpeaking: 0
    npcName: 
  - text: "\u041B\u0430\u0434\u043D\u043E, \u043D\u0435 \u0432\u043E\u0440\u0447\u0438.
      [R]"
    isPlayerSpeaking: 1
    npcName: 
  - text: "\u0410 \u0447\u0442\u043E \u044D\u0442\u043E \u0442\u0430\u043C \u0441\u043F\u0440\u0430\u0432\u0430
      \u0437\u0430 \u043C\u0443\u0436\u0447\u0438\u043D\u0430 \u0441\u0442\u043E\u0438\u0442?
      [R]"
    isPlayerSpeaking: 1
    npcName: 
  - text: "\u041D\u0435 \u0437\u043D\u0430\u044E. \u041F\u043E\u0434\u043E\u0439\u0434\u0438
      \u043A \u043D\u0435\u043C\u0443 \u0438 \u0441\u043F\u0440\u043E\u0441\u0438
      - \u043D\u0430\u043A\u0430\u0437\u0430\u043D\u0438\u0435 \u0442\u0435\u0431\u0435,
      \u0437\u0430 \u0442\u043E, \u0447\u0442\u043E \u043C\u043D\u0435 \u0441\u0435\u0433\u043E\u0434\u043D\u044F
      \u0441\u043A\u0443\u043D\u043E \u0431\u044B\u043B\u043E \u043E\u0434\u043D\u043E\u043C\u0443.
      [R]"
    isPlayerSpeaking: 0
    npcName: 
  - text: "\u0412\u043E\u0442 \u0442\u044B \u043A\u043E\u043D\u0435\u0447\u043D\u043E!
      \u041B\u0430\u0434\u043D\u043E.. [R]"
    isPlayerSpeaking: 0
    npcName: 
