  dialogueId: e6nubue
  oneTimeUse: 1
  isPlayerSpeaking: 1
  npcName: 
  lines:
  - text: "\u0417\u0434\u0440\u0430\u0432\u0441\u0442\u0432\u0443\u0439\u0442\u0435!
      \u042F \u0432\u0430\u0441 \u0432 \u0448\u043A\u043E\u043B\u0435 \u0440\u0430\u043D\u044C\u0448\u0435
      \u043D\u0435 \u0432\u0438\u0434\u0435\u043B.  \u0423 \u0432\u0430\u0441 \u0442\u0443\u0442
      \u043A\u0430\u043A\u043E\u0435-\u0442\u043E \u0434\u0435\u043B\u043E? [R]"
    isPlayerSpeaking: 1
    npcName: 
  - text: "\u041F\u0440\u0438\u0432\u0435\u0442, \u043F\u0430\u0440\u0435\u043D\u044C.
      \u042F \u0412\u0438\u043A\u0442\u043E\u0440 \u0421\u0435\u0440\u0433\u0435\u0435\u0432\u0438\u0447,
      \u0441\u043E\u0446\u0440\u0430\u0431\u043E\u0442\u043D\u0438\u043A. \u0421\u0435\u0439\u0447\u0430\u0441
      \u043C\u044B \u0437\u0430\u043D\u0438\u043C\u0430\u0435\u043C\u0441\u044F \u043E\u0431\u043B\u0430\u0433\u043E\u0440\u0430\u0436\u0438\u0432\u0430\u043D\u0438\u0435\u0438
      \u043A\u0430\u043D\u0430\u043B\u0438\u0437\u0430\u0446\u0438\u0438. [R]"
    isPlayerSpeaking: 0
    npcName: "\u041D\u0435\u0438\u0437\u0432\u0435\u0441\u0442\u043D\u044B\u0439
      \u043C\u0443\u0436\u0447\u0438\u043D\u0430"
  - text: "\u041A\u0430\u043D\u0430\u043B\u0438\u0437\u0430\u0446\u0438\u044E \u043E\u0431\u043B\u0430\u0433\u043E\u0440\u0430\u0436\u0438\u0432\u0430\u044E\u0442?
      \u041D\u0438\u043A\u043E\u0433\u0434\u0430 \u043E \u0442\u0430\u043A\u043E\u043C
      \u043D\u0435 \u0441\u043B\u044B\u0448\u0430\u043B. [R]"
    isPlayerSpeaking: 1
    npcName: 
  - text: "\u0411\u0443\u0434\u044C \u043E\u0441\u0442\u0430\u0440\u043E\u0436\u043D\u0435\u0439,
      \u043D\u0435 \u0443\u043F\u0430\u0434\u0438 \u0432 \u043B\u044E\u043A. [R]"
    isPlayerSpeaking: 0
    npcName: "\u0412\u0438\u043A\u0442\u043E\u0440 \u0421\u0435\u0440\u0433\u0435\u0435\u0432\u0438\u0447"
  - text: "\u0425\u043C\u043C, \u043D\u0430\u0434\u043E \u0431\u044B \u0433\u043B\u044F\u043D\u0443\u0442\u044C.
      [R]"
    isPlayerSpeaking: 1
    npcName: 
