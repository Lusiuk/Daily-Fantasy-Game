  m_Script: {fileID: 11500000, guid: da0ce09f1e1f89b43ab3ba879ccf71a6, type: 3}
  m_Name: TheGoodEnd
  m_EditorClassIdentifier: Assembly-CSharp::Dialogue
  text: 
  canInteract: 1
  triggerSceneTransition: 1
  targetSceneName: Credits
  teleportAfterDialogue: 0
  teleportPosition: {x: 0, y: 0}
  teleportMarkerName: 
  typewriterMusic: {fileID: 8300000, guid: dd4068423f967d241aa87d438833ed6c, type: 3}
  loopMusic: 1
  dialogueId: 
  oneTimeUse: 0
  trackForCondition: 0
  centerDialoguePanel: 1
  isPlayerSpeaking: 1
  npcName: NPC
  lines:
  - text: "\u0417\u0430\u0432\u0442\u0440\u0430 \u043D\u0430\u0434\u043E \u0432 \u0448\u043A\u043E\u043B\u0443.
      [R]"
    isPlayerSpeaking: 1
    npcName: 
  - text: "\u0417\u0430\u0432\u0442\u0440\u0430 \u0441\u043D\u043E\u0432\u0430 \u0431\u0443\u0434\u0435\u0442
      \u0432\u044B\u0431\u043E\u0440. [R]"
    isPlayerSpeaking: 1
    npcName: 
  - text: "\u041D\u0430\u0441\u0442\u0443\u043F\u0438\u043B \u043D\u043E\u0432\u044B\u0439
      \u0434\u0435\u043D\u044C. [R]"
    isPlayerSpeaking: 1
    npcName: 
  - text: "\u0418 \u044F \u0431\u0443\u0434\u0443 \u043F\u0440\u043E\u0434\u043E\u043B\u0436\u0430\u0442\u044C
      \u0438\u0434\u0442\u0438 \u0432\u043F\u0435\u0440\u0451\u0434. [R]"
    isPlayerSpeaking: 1
    npcName: 
  - text: "\u041D\u0430 \u043F\u0435\u0440\u0435\u043C\u0435\u043D\u043A\u0435 \u044F
      \u043F\u0440\u043E\u0445\u043E\u0434\u0438\u043B \u043C\u0438\u043C\u043E \u043E\u0434\u043D\u043E\u043A\u043B\u0430\u0441\u0441\u043D\u0438\u0446\u044B.
      [R]"
    isPlayerSpeaking: 1
    npcName: 
  - text: "\u0412\u043C\u0435\u0441\u0442\u043E \u0442\u043E\u0433\u043E \u0447\u0442\u043E\u0431\u044B
      \u043C\u043E\u043B\u0447\u0430\u0442\u044C, \u044F \u0441\u043F\u0440\u043E\u0441\u0438\u043B
      \u0435\u0451, \u043A\u0430\u043A \u0434\u0435\u043B\u0430. [R]"
    isPlayerSpeaking: 1
    npcName: 
  - text: "\u041E\u043D\u0430 \u0443\u0434\u0438\u0432\u0438\u043B\u0430\u0441\u044C,
      \u043D\u043E \u043E\u0442\u0432\u0435\u0442\u0438\u043B\u0430. [R]"
    isPlayerSpeaking: 1
    npcName: 
  - text: "\u041C\u044B \u0432\u043C\u0435\u0441\u0442\u0435 \u043F\u043E\u0441\u043C\u0435\u044F\u043B\u0438\u0441\u044C
      \u043D\u0430\u0434 \u0435\u0451 \u0438\u0441\u0442\u043E\u0440\u0438\u0435\u0439.
      [R]"
    isPlayerSpeaking: 1
    npcName: 
  - text: "\u041C\u043D\u0435 \u0431\u044B\u043B\u043E \u0432\u0435\u0441\u0435\u043B\u043E.
      [R]"
    isPlayerSpeaking: 1
    npcName: 
  - text: "\u0412\u0441\u0442\u0440\u0435\u0442\u0438\u043B \u041F\u0435\u0442\u044E
      \u043F\u043E \u043F\u0443\u0442\u0438 \u0434\u043E\u043C\u043E\u0439. [R]"
    isPlayerSpeaking: 1
    npcName: 
  - text: "\u0420\u0430\u0441\u0441\u043A\u0430\u0437\u0430\u043B \u0435\u043C\u0443
      \u043E \u0441\u0432\u043E\u0438\u0445 \u043F\u0440\u0438\u043A\u043B\u044E\u0447\u0435\u043D\u0438\u044F\u0445
      \u0432 \u043A\u0430\u043D\u0430\u043B\u0438\u0437\u0430\u0446\u0438\u0438.
      [R]"
    isPlayerSpeaking: 1
    npcName: 
  - text: "\u041E\u043D \u043F\u0440\u0435\u0434\u043B\u043E\u0436\u0438\u043B \u043C\u043D\u0435
      \u043F\u0438\u0441\u0430\u0442\u044C \u0440\u0430\u0441\u0441\u043A\u0430\u0437\u044B.
      [R]"
    isPlayerSpeaking: 1
    npcName: 
  - text: "\u042F \u0437\u0430\u0434\u0443\u043C\u0430\u043B\u0441\u044F, \u043C\u043E\u0436\u0435\u0442
      \u0434\u0435\u0439\u0441\u0442\u0432\u0438\u0442\u0435\u043B\u044C\u043D\u043E
      \u043F\u043E\u043F\u0440\u043E\u0431\u043E\u0432\u0430\u0442\u044C? [R]"
    isPlayerSpeaking: 1
    npcName: 
  - text: "\u0412 \u0442\u0440\u0435\u0442\u0438\u0439 \u0440\u0430\u0437 \u044F
      \u043F\u0440\u043E\u0448\u0451\u043B \u0438\u0433\u0440\u0443 \u0431\u044B\u0441\u0442\u0440\u0435\u0435,
      \u0447\u0435\u043C \u0440\u0430\u043D\u044C\u0448\u0435. [R]"
    isPlayerSpeaking: 1
    npcName: 
  - text: "\u041D\u0435 \u043F\u043E\u0442\u043E\u043C\u0443, \u0447\u0442\u043E
      \u044F \u0441\u0442\u0430\u043B \u0443\u043C\u043D\u0435\u0435 \u0438\u043B\u0438
      \u0432\u043D\u0438\u043C\u0430\u0442\u0435\u043B\u044C\u043D\u0435\u0435. [R]"
    isPlayerSpeaking: 1
    npcName: 
  - text: "\u041F\u0440\u043E\u0441\u0442\u043E \u043F\u0435\u0440\u0435\u0441\u0442\u0430\u043B
      \u0431\u043E\u044F\u0442\u044C\u0441\u044F \u043F\u0440\u043E\u0431\u043E\u0432\u0430\u0442\u044C
      \u0447\u0442\u043E-\u0442\u043E \u043D\u043E\u0432\u043E\u0435. [R]"
    isPlayerSpeaking: 1
    npcName: 
  - text: "\u042F \u0431\u044B\u043B \u0440\u0430\u0434. [R]"
    isPlayerSpeaking: 1
    npcName: 
  - text: "\u0414\u043E\u043C\u0430 \u043C\u0430\u043C\u0430 \u0441\u043F\u0440\u043E\u0441\u0438\u043B\u0430,
      \u043A\u0430\u043A \u0434\u0435\u043B\u0430 \u0432 \u0448\u043A\u043E\u043B\u0435.
      [R]"
    isPlayerSpeaking: 1
    npcName: 
  - text: "\u042F \u0440\u0430\u0441\u0441\u043A\u0430\u0437\u0430\u043B \u0435\u0439,
      \u043F\u043E-\u043D\u0430\u0441\u0442\u043E\u044F\u0449\u0435\u043C\u0443 \u0432\u0441\u0451
      \u0440\u0430\u0441\u0441\u043A\u0430\u0437\u0430\u043B. [R]"
    isPlayerSpeaking: 1
    npcName: 
  - text: "\u041E\u043D\u0430 \u0443\u043B\u044B\u0431\u043D\u0443\u043B\u0430\u0441\u044C
      \u0438 \u043E\u0431\u043D\u044F\u043B\u0430 \u043C\u0435\u043D\u044F. [R]"
    isPlayerSpeaking: 1
    npcName: 
  - text: "\u042D\u0442\u043E \u0431\u044B\u043B\u043E \u043F\u0440\u0438\u044F\u0442\u043D\u043E.
      [R]"
    isPlayerSpeaking: 1
    npcName: 
  - text: "\u042F \u043B\u0435\u0436\u0443 \u043D\u0430 \u043A\u0440\u043E\u0432\u0430\u0442\u0438
      \u0438 \u0441 \u043D\u0435\u0442\u0435\u0440\u043F\u0435\u043D\u0438\u0435\u043C
      \u0436\u0434\u0443 \u0437\u0430\u0432\u0442\u0440\u0430\u0448\u043D\u0435\u0433\u043E
      \u0434\u043D\u044F. [R]"
    isPlayerSpeaking: 1
    npcName: 
  - text: "\u0412\u043F\u0435\u0440\u0432\u044B\u0435 \u0437\u0430 \u0434\u043E\u043B\u0433\u043E\u0435
      \u0432\u0440\u0435\u043C\u044F \u044F \u043D\u0435 \u0432\u043E\u043B\u043D\u0443\u044E\u0441\u044C.
      [R]"
    isPlayerSpeaking: 1
    npcName: 
  - text: "\u0418 \u044D\u0442\u043E \u0442\u0430\u043A \u043F\u0440\u0438\u044F\u0442\u043D\u043E.
      [R]"
    isPlayerSpeaking: 1
    npcName: 
  - text: "\u0421\u043F\u0430\u0441\u0438\u0431\u043E. [R]"
    isPlayerSpeaking: 1
    npcName: 
